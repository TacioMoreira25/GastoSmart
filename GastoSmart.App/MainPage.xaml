<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gastosmart.App.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Center">

            <Button
                Text="Tirar Foto do Recibo" 
                Clicked="OnTakePhotoClicked"
                HorizontalOptions="Fill" />

            <Button
                Text="Escolher da Galeria" 
                Clicked="OnPickPhotoClicked"
                HorizontalOptions="Fill" />

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" />

            <Label x:Name="TitleLabel" FontSize="18" FontAttributes="Bold" />
            <Label x:Name="AmountLabel" FontSize="18" TextColor="Green" />
            <Label x:Name="DateLabel" FontSize="16" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
