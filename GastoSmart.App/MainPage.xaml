<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GastoSmart.App.MainPage"
             Title="GastoSmart AI">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Image x:Name="ReceiptImage" HeightRequest="250" BackgroundColor="#EAEAEA" />

            <Button Text="📸 Tirar Foto" Clicked="OnTakePhotoClicked" />
            <Button Text="🖼️ Escolher da Galeria" Clicked="OnPickPhotoClicked" />

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="Blue" />

            <Border x:Name="ResultFrame" IsVisible="False" Padding="20" BackgroundColor="#F8F9FA">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="✨ Resultado da IA" FontAttributes="Bold" FontSize="18" TextColor="DarkBlue"/>
                    
                    <Label Text="Título:" FontAttributes="Bold" />
                    <Label x:Name="TitleLabel" />

                    <Label Text="Valor:" FontAttributes="Bold" />
                    <Label x:Name="AmountLabel" />

                    <Label Text="Data:" FontAttributes="Bold" />
                    <Label x:Name="DateLabel" />

                    <Button Text="✅ Confirmar e Salvar" Clicked="OnSaveTransactionClicked" Margin="0,15,0,0" BackgroundColor="Green" TextColor="White" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>