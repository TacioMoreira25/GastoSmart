<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GastoSmart.App.RegisterPage"
             Title="Criar Conta"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
            
            <Label Text="GastoSmart" FontSize="32" FontAttributes="Bold" TextColor="#2B32B2" HorizontalOptions="Center" Margin="0,0,0,10"/>
            <Label Text="Crie a sua conta" FontSize="16" TextColor="#555555" HorizontalOptions="Center" Margin="0,0,0,20"/>

            <Border BackgroundColor="White" Stroke="#CECECE" StrokeThickness="1" Padding="10,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Entry x:Name="NameEntry" Placeholder="Nome completo" TextColor="Black"/>
            </Border>

            <Border BackgroundColor="White" Stroke="#CECECE" StrokeThickness="1" Padding="10,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Entry x:Name="EmailEntry" Placeholder="E-mail" Keyboard="Email" TextColor="Black"/>
            </Border>

            <Border BackgroundColor="White" Stroke="#CECECE" StrokeThickness="1" Padding="10,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Entry x:Name="PasswordEntry" Placeholder="Senha" IsPassword="True" TextColor="Black"/>
            </Border>

            <Border BackgroundColor="White" Stroke="#CECECE" StrokeThickness="1" Padding="10,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Entry x:Name="ConfirmPasswordEntry" Placeholder="Confirmar Senha" IsPassword="True" TextColor="Black"/>
            </Border>

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="#27AE60" />

            <Button x:Name="RegisterButton" Text="Criar Conta" Clicked="OnRegisterClicked" BackgroundColor="#27AE60" TextColor="White" CornerRadius="8" FontAttributes="Bold" HeightRequest="50" Margin="0,10,0,0"/>

            <Button Text="Já tem conta? Fazer Login" Clicked="OnBackToLoginClicked" BackgroundColor="Transparent" TextColor="#2B32B2" FontAttributes="Bold" Margin="0,5,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
