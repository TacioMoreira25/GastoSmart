<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:GastoSmart.App.ViewModels"
             x:Class="GastoSmart.App.NovaTransacaoPage"
             Title="Nova Transação"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}">
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="20">
                <Label Text="Nova Transação" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,20"/>
                
                <Button Text="📸 Escanear Recibo com IA" Command="{Binding EscanearReciboCommand}" BackgroundColor="#6C5CE7" TextColor="White" FontAttributes="Bold" IsEnabled="{Binding IsNotScanning}" />
                
                <VerticalStackLayout IsVisible="{Binding IsScanning}" HorizontalOptions="Center" Spacing="10">
                    <ActivityIndicator IsRunning="{Binding IsScanning}" Color="{StaticResource Primary}" HorizontalOptions="Center" />
                    <Label Text="A IA está a ler o recibo..." TextColor="{StaticResource Gray200}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Label Text="Descrição" FontAttributes="Bold" />
                <Entry Text="{Binding Descricao}" Placeholder="Ex: Mercado" IsEnabled="{Binding IsNotScanning}" />

                <Label Text="Valor" FontAttributes="Bold" />
                <Entry Text="{Binding Valor}" Placeholder="0.00" Keyboard="Numeric" IsEnabled="{Binding IsNotScanning}" />

                <Label Text="Data" FontAttributes="Bold" />
                <DatePicker Date="{Binding Data}" IsEnabled="{Binding IsNotScanning}" />

                <Label Text="Tipo" FontAttributes="Bold" />
                <Picker SelectedItem="{Binding Tipo}" Title="Selecione o tipo" IsEnabled="{Binding IsNotScanning}">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Despesa</x:String>
                            <x:String>Receita</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center" Margin="0,30,0,0">
                    <Button Text="Cancelar" Command="{Binding CancelarCommand}" BackgroundColor="Gray" WidthRequest="120" IsEnabled="{Binding IsNotScanning}" />
                    <Button Text="Salvar" Command="{Binding SalvarCommand}" BackgroundColor="{StaticResource Primary}" WidthRequest="120" IsEnabled="{Binding IsNotScanning}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
